# Model API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=
OPENAI_ENABLE_REVIEW=true
OPENAI_MAX_GENERATION_ATTEMPTS=3

# Retrieval
GSIS_CROSSREF_URL=https://api.crossref.org/journals/1009-5020/works
GSIS_DOAJ_URL=https://doaj.org/api/search/articles
GSIS_DOAJ_ISSN=1993-5153
GSIS_LOOKBACK_DAYS=14
GSIS_REQUEST_TIMEOUT=30
GSIS_MAX_ARTICLES_PER_RUN=20
GSIS_USER_AGENT=GSIS-Notifier/0.2.1 (personal academic monitor; contact=your-email@example.com)

# Persistent local state
GSIS_DB_PATH=data/gsis.db
GSIS_LOG_DIR=logs

# Feishu custom bot (leave empty until dry-run tests pass)
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_MAX_MESSAGE_CHARS=15000
